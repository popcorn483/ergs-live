{
 "name": "ERGS Rugby",
 "short_name": "ERGS Rugby",
 "description": "Enniskillen Royal Grammar School rugby in one app: live scores, fixtures and results, and the team app for players, parents and coaches.",
 "id": "./",
 "start_url": "./",
 "scope": "./",
 "launch_handler": {
  "client_mode": [
   "navigate-existing",
   "auto"
  ]
 },
 "handle_links": "preferred",
 "display": "standalone",
 "background_color": "#0F1530",
 "theme_color": "#0F1530",
 "icons": [
  {
   "src": "icons/icon-192.png",
   "sizes": "192x192",
   "type": "image/png"
  },
  {
   "src": "icons/icon-512.png",
   "sizes": "512x512",
   "type": "image/png"
  },
  {
   "src": "icons/icon-maskable-512.png",
   "sizes": "512x512",
   "type": "image/png",
   "purpose": "maskable"
  }
 ],
 "shortcuts": [
  {
   "name": "ERGS Live: scores and fixtures",
   "short_name": "ERGS Live",
   "url": "./?side=live",
   "icons": [
    {
     "src": "icons/icon-192.png",
     "sizes": "192x192",
     "type": "image/png"
    }
   ]
  },
  {
   "name": "Team app: players, parents and coaches",
   "short_name": "Team app",
   "url": "./app/",
   "icons": [
    {
     "src": "icons/icon-192.png",
     "sizes": "192x192",
     "type": "image/png"
    }
   ]
  }
 ]
}
