rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ---- AI in School newsletter (popcorn483.github.io/ai-newsletter/) ----
    // Content is encrypted with the staff password, so anyone may read; only the editor may write.
    function nlEditor() { return request.auth != null && request.auth.token.email is string && request.auth.token.email_verified == true && request.auth.token.email.lower() in ['jbutler803@c2ken.net', 'jbutler803@c2kni.net']; }
    match /newsletter/{doc} {
      allow read: if true;
      allow write: if nlEditor() && request.resource.data.releases is map;
    }
    match /newsletterIssues/{id} {
      allow read: if true;
      allow write: if nlEditor() && request.resource.data.enc is string && request.resource.data.enc.size() < 400000;
      allow delete: if nlEditor();
    }
    match /newsletterImgs/{id} {
      allow read: if true;
      allow write: if nlEditor() && request.resource.data.data is string && request.resource.data.data.size() < 1000000;
      allow delete: if nlEditor();
    }
    // Anonymous staff usage: one doc per device. Only devices with the staff key (token) can write; only the editor can read.
    match /newsletterVisits/{id} {
      allow get: if true;               // a device can read its own (random, unguessable) record
      allow list, delete: if nlEditor(); // only the editor sees the totals
      allow create: if id.size() <= 40 && request.resource.data.keys().hasOnly(['t','first','last','n','app','mob'])
        && request.resource.data.t == '0ddd4e393a7f0180e83d86fa' && request.resource.data.first == request.time
        && request.resource.data.last == request.time && request.resource.data.n == 1
        && request.resource.data.app is bool && request.resource.data.mob is bool;
      allow update: if request.resource.data.keys().hasOnly(['t','first','last','n','app','mob'])
        && request.resource.data.t == '0ddd4e393a7f0180e83d86fa' && request.resource.data.first == resource.data.first
        && request.resource.data.last == request.time && request.resource.data.n == resource.data.n + 1
        && request.resource.data.app is bool && request.resource.data.mob is bool;
    }
    // Tip of the day log: one doc per date, written once by the first staff device that opens the site that day (staff key token).
    match /newsletterTipLog/{day} {
      allow read: if true;
      allow create: if day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && request.resource.data.keys().hasOnly(['id','at','t'])
        && request.resource.data.t == '0ddd4e393a7f0180e83d86fa' && request.resource.data.id is string && request.resource.data.id.size() < 120
        && request.resource.data.at == request.time;
      allow update, delete: if nlEditor();
    }
    // signed in with a verified email; Google sign-ins always own their address (some school accounts don't mark it verified)
    function proved() { return request.auth != null && request.auth.token.email is string && (request.auth.token.email_verified == true || request.auth.token.firebase.sign_in_provider == 'google.com' || 'google.com' in request.auth.token.firebase.identities); }   // …or the account has Google on it (a coach who added a password to their Google sign-in)
    // a school C2k address signed in with a password it set itself (18 November 2026): enough for a PLAYER profile, never for a
    // coach. Its address isn't proved, so it gets nothing that isn't already on a player profile under that address.
    function pwC2k() { return request.auth != null && request.auth.token.email is string && request.auth.token.firebase.sign_in_provider == 'password' && request.auth.token.email.lower().matches('.*@c2k(en|ni)[.]net$'); }
    function signedIn() { return proved() || pwC2k(); }
    function me() { return request.auth.token.email.lower(); }
    function isAdmin() { return proved() && me() == 'ergsrugby@gmail.com'; }
    // C2k: @c2ken.net and @c2kni.net are the same person, so either address gets the other's access
    function twinA() { return me().replace('@c2ken[.]net$', '@c2kni.net'); }
    function twinB() { return me().replace('@c2kni[.]net$', '@c2ken.net'); }
    // a player's second sign-in email: players/<second> = {aliasOf: <main email>}, set by a coach; it acts as the main one
    function aliasFor(email) { return exists(/databases/$(database)/documents/players/$(me())) && get(/databases/$(database)/documents/players/$(me())).data.get('aliasOf', '') == email; }
    // "own": the address itself, which costs nothing to check. "mine" also allows a player's second sign-in email, which needs a look-up.
    // Every exists()/get() in these rules is charged as a document read on each request, so the checks that cost nothing come first
    // and the commonest case (a player) is tried before the rarer one (a coach). What is allowed is unchanged.
    function own(email) { return signedIn() && (me() == email || twinA() == email || twinB() == email); }
    function mine(email) { return own(email) || (signedIn() && aliasFor(email)); }
    function onList(col) { return exists(/databases/$(database)/documents/$(col)/$(me())) || exists(/databases/$(database)/documents/$(col)/$(twinA())) || exists(/databases/$(database)/documents/$(col)/$(twinB())); }
    function isCoach() { return isAdmin() || (proved() && onList('coaches')); }
    function isPlayer() { return signedIn() && onList('players'); }
    function isSquad() { return isAdmin() || isPlayer() || isCoach(); }

    // ERGS Live scoreboard: anyone can watch, only coaches can score
    match /live/{doc} {
      allow read: if true;
      allow write: if isCoach() && request.resource.data.json is string && request.resource.data.json.size() < 900000;
    }
    // live viewers count: each open page checks in while a match is live (no sign-in needed); only the time can be written
    match /viewers/{mid}/s/{sid} {
      allow read: if true;
      allow create, update: if mid.size() < 80 && sid.size() < 40 && request.resource.data.keys().hasOnly(['at', 'exp']) && request.resource.data.at == request.time && request.resource.data.exp is timestamp;
      allow delete: if true;
    }
    // who can sign in
    match /coaches/{email} {
      allow read: if (proved() && (own(email) || mine(email))) || isCoach();
      allow write: if isCoach();
    }
    // someone who signed in but isn't on a list yet leaves a request; coaches see it and add them as a player or coach
    match /requests/{email} {
      function reqOK() { return request.resource.data.keys().hasOnly(['name', 'photo', 'at', 'squad', 'pos', 'sent', 'resend', 'kind', 'follow', 'child', 'coachOf', 'iam', 'pw']) && (!('iam' in request.resource.data) || request.resource.data.iam in ['player', 'guardian', 'coach', 'supporter']) && (!('follow' in request.resource.data) || (request.resource.data.follow is list && request.resource.data.follow.size() <= 12)) && (!('kind' in request.resource.data) || request.resource.data.kind in ['', 'supporter', 'guardian', 'coach']) && (!('coachOf' in request.resource.data) || (request.resource.data.coachOf is list && request.resource.data.coachOf.size() <= 8)) && (!('child' in request.resource.data) || (request.resource.data.child is string && request.resource.data.child.size() < 80)) && (!('squad' in request.resource.data) || (request.resource.data.squad is string && request.resource.data.squad.size() < 20)) && (!('pos' in request.resource.data) || (request.resource.data.pos is string && request.resource.data.pos.size() < 4)) && request.resource.data.name is string && request.resource.data.name.size() < 120; }
      // a C2k address that set its own password and isn't on a player profile yet (18 November 2026): it may ask to be let in as a
      // PLAYER, under its own address only. The request is marked pw (the address hasn't been proved), so the coach sees that.
      function pwAsk() { return pwC2k() && own(email); }
      function pwAskOK() { return request.resource.data.get('pw', false) == true && request.resource.data.get('kind', '') == '' && request.resource.data.get('iam', 'player') == 'player' && !('coachOf' in request.resource.data) && !('child' in request.resource.data) && !('follow' in request.resource.data); }
      function asker() { return (proved() && mine(email)) || (pwAsk() && pwAskOK()); }
      allow read: if (proved() && (own(email) || mine(email))) || pwAsk() || isCoach();
      // rejected by a coach (18 November 2026): the request stays, marked rejected, so it can't simply be sent again. Whoever
      // it belongs to can no longer change or remove it; a coach can remove it to let them ask again.
      function notRej() { return resource.data.get('rejected', false) != true; }
      allow delete: if (proved() && (own(email) || mine(email)) && notRej()) || isCoach();   // a supporter can remove themselves
      allow create, update: if isCoach();   // a coach can reset the one-hour wait, mark someone as a supporter, or put someone on the list from Access
      allow create: if asker() && reqOK();
      // sending again: once an hour, or straight away after a coach resets it; other updates (photo, last seen) don't touch 'sent'
      allow update: if asker() && notRej() && reqOK() && (!('sent' in resource.data) || request.resource.data.get('sent', 0) == resource.data.sent || resource.data.get('resend', false) == true || request.time.toMillis() - resource.data.sent > 3600000);
    }
    // a player sends their own headshot (once a season, unless a coach opens it again); coaches approve it
    match /headshots/{email} {
      allow read: if own(email) || isCoach() || mine(email);
      allow create: if isCoach();   // moving a person's record to their new email when a coach changes their login
      allow update, delete: if isCoach();
      allow create, update: if isPlayer() && mine(email)
        && request.resource.data.status == 'pending' && request.resource.data.photo is string && request.resource.data.photo.size() < 950000
        && request.resource.data.season is string
        && (resource == null || resource.data.status == 'open' || resource.data.season != request.resource.data.season);
      // a player can take their own headshot down (they then can't send another this season unless a coach lets them)
      // a player can mark a coach's decision as seen (only the 'seen' field changes)
      allow update: if isPlayer() && mine(email) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seen']);
      allow create, update: if isPlayer() && mine(email) && request.resource.data.status == 'removed' && request.resource.data.photo == '' && request.resource.data.season is string;
    }
    // a player says whether they can play each match; coaches see it when picking the team
    match /avail/{email} {
      allow read: if own(email) || isCoach() || mine(email);
      allow create: if isCoach();   // moving a person's record to their new email when a coach changes their login
      allow write: if isPlayer() && mine(email) && request.resource.data.keys().hasOnly(['m', 'name', 'team', 'rid', 'at']) && request.resource.data.m.size() < 60;
      allow delete: if isCoach();
    }
    match /players/{email} {
      allow read: if own(email) || isCoach() || mine(email);
      allow write: if isCoach();
    }
    // main app: plays, squads and pictures for coaches and players; everything else coaches only
    match /team/{doc} { allow read: if isSquad(); allow write: if isCoach(); }
    match /plays/{doc} { allow read: if isSquad(); allow write: if isCoach(); }
    match /images/{doc} { allow read: if isSquad(); allow write: if isCoach(); }
    match /totw/{doc} { allow read, write: if isCoach(); }
    match /drills/{doc} { allow read: if isSquad(); allow write: if isCoach(); }
    match /analysis/{doc} { allow read: if isSquad(); allow write: if isCoach(); }   // video analysis sessions
    // small headshots for the score animations on ERGS Live: anyone can see them, only coaches add them
    match /faces/{doc} {
      allow read: if true;
      allow write: if isCoach() && request.resource.data.d is string && request.resource.data.d.size() < 120000;
      allow delete: if isCoach();
    }
    // Play IQ leaderboard: each person's best scores; the squad can see the board, you only write your own, coaches can remove an entry
    match /piq/{email} {
      allow read: if isSquad();
      allow create: if isCoach();   // moving a person's record to their new email when a coach changes their login
      allow delete: if isCoach();
      allow create, update: if isSquad() && mine(email)
        && request.resource.data.keys().hasOnly(['name', 'team', 'week', 'best', 'wk', 'sd', 'sdWk', 'games', 'updated'])
        && request.resource.data.name is string && request.resource.data.name.size() < 60
        && request.resource.data.best is number && request.resource.data.best <= 20000 && request.resource.data.wk is number && request.resource.data.wk <= 20000
        && request.resource.data.sd is number && request.resource.data.sd <= 1000 && request.resource.data.sdWk is number && request.resource.data.sdWk <= 1000;
    }
    // approval emails to the head coach: anyone signed in reads the settings (so a new request can send one), only coaches change them
    match /notify/{doc} { allow read: if signedIn(); allow write: if isCoach(); }   // read by whoever sends a request, so the coach is emailed
    // Team news: coaches post to a squad (or everyone); the squad reads them
    match /posts/{id} {
      allow read: if isSquad();
      allow create, update: if isCoach() && request.resource.data.text is string && request.resource.data.text.size() < 4000 && request.resource.data.at is number;
      allow delete: if isCoach();
    }
    // read receipts: one doc per player (p: the player's own reads, g: their parent/guardian's); coaches see them all
    match /reads/{email} {
      allow read: if own(email) || isCoach() || mine(email);
      allow create: if isCoach();   // moving a person's record to their new email when a coach changes their login
      allow create, update: if isSquad() && mine(email) && request.resource.data.keys().hasOnly(['p', 'g', 'name', 'at']) && request.resource.data.get('p', {}).size() < 400 && request.resource.data.get('g', {}).size() < 400;
      allow delete: if isCoach();
    }
    // a player's own match record: games they played, their position and stats they counted from the VEO; coaches read them all
    match /pstats/{email} {
      allow read: if own(email) || isCoach() || mine(email);
      allow create: if isCoach();   // moving a person's record to their new email when a coach changes their login
      allow create, update: if isSquad() && mine(email) && request.resource.data.keys().hasOnly(['g', 'name', 'team', 'at']) && request.resource.data.g is map && request.resource.data.g.size() <= 150 && request.resource.data.name is string && request.resource.data.name.size() < 80;
      allow delete: if isCoach();
    }
    // photo likes: one doc per person (the photos they ♥); everyone in the squad sees the counts
    match /likes/{email} {
      allow read: if isSquad();
      allow create: if isCoach();   // moving a person's record to their new email when a coach changes their login
      allow create, update: if isSquad() && mine(email) && request.resource.data.keys().hasOnly(['p', 'name', 'at']) && request.resource.data.p is map && request.resource.data.p.size() <= 500 && request.resource.data.at is number;
      allow delete: if own(email) || isCoach() || mine(email);
    }
    // photo tags: a player tags themselves in match photos (p: photo id -> where they are); the squad sees them; coaches can take a tag off
    match /phtags/{email} {
      allow read: if isSquad();
      allow create, update: if (isCoach() || (isPlayer() && mine(email))) && request.resource.data.keys().hasOnly(['p', 'name', 'at']) && request.resource.data.p is map && request.resource.data.p.size() <= 400 && request.resource.data.at is number;
      allow delete: if own(email) || isCoach() || mine(email);
    }
    // activity log: every coach's approvals and access changes are written as they happen; only the admin account reads or clears it
    match /audit/{id} {
      allow read, delete: if isAdmin();
      allow create: if isCoach() && request.resource.data.keys().hasOnly(['at', 'by', 'act', 'who', 'det']) && request.resource.data.by == me() && request.resource.data.at is number
        && request.resource.data.act is string && request.resource.data.act.size() < 100 && request.resource.data.who is string && request.resource.data.who.size() < 150 && request.resource.data.det is string && request.resource.data.det.size() < 400;
    }
    // match alerts: a phone asks to be notified before kick-off (anyone, signed in or not; a coach's is marked so it is also told
    // to start the match). The scheduled job that sends them (.github/workflows/kickoff.yml) has no login, so these are readable;
    // they are no use without the job's private key. A registration can't be pointed at a different phone once made.
    match /pushsubs/{id} {
      allow read: if true;
      allow create, update: if id.size() < 80 && request.resource.data.keys().hasOnly(['sub', 'teams', 'at', 'coach', 'kinds']) && (!('kinds' in request.resource.data) || (request.resource.data.kinds is list && request.resource.data.kinds.size() <= 8))
        && request.resource.data.sub is string && request.resource.data.sub.size() < 2500 && request.resource.data.teams is list && request.resource.data.teams.size() <= 20
        && request.resource.data.at is number && (!('coach' in request.resource.data) || (request.resource.data.coach == true && isCoach()))
        && (resource == null || resource.data.sub == request.resource.data.sub);
      allow delete: if true;
    }
    // alerts a coach's app asks to be sent (a new photo album): a short public queue the sending job reads. No names, no emails.
    match /pushq/{id} {
      allow read: if true;
      allow create: if isCoach() && id.size() < 80 && request.resource.data.keys().hasOnly(['k', 'team', 'title', 'body', 'url', 'at'])
        && request.resource.data.title is string && request.resource.data.title.size() < 121 && request.resource.data.body is string && request.resource.data.body.size() < 241 && request.resource.data.at is number;
      allow delete: if isCoach();
    }
    match /sponsors/{doc} { allow read, write: if isCoach(); }
    match /sheets/{doc} { allow read, write: if isCoach(); }
    match /members/{uid} {
      allow read: if isCoach();
      allow write: if isSquad() && request.auth.uid == uid;
      allow delete: if isCoach();   // Access › Everyone signed in: delete someone's sign-in history
    }
  }
}
