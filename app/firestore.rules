rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // signed in with a verified email; Google sign-ins always own their address (some school accounts don't mark it verified)
    function signedIn() { return request.auth != null && request.auth.token.email is string && (request.auth.token.email_verified == true || request.auth.token.firebase.sign_in_provider == 'google.com'); }
    function me() { return request.auth.token.email.lower(); }
    function isAdmin() { return signedIn() && me() == 'ergsrugby@gmail.com'; }
    // C2k: @c2ken.net and @c2kni.net are the same person, so either address gets the other's access
    function twinA() { return me().replace('@c2ken[.]net$', '@c2kni.net'); }
    function twinB() { return me().replace('@c2kni[.]net$', '@c2ken.net'); }
    // a player's second sign-in email: players/<second> = {aliasOf: <main email>}, set by a coach; it acts as the main one
    function aliasFor(email) { return exists(/databases/$(database)/documents/players/$(me())) && get(/databases/$(database)/documents/players/$(me())).data.get('aliasOf', '') == email; }
    function mine(email) { return signedIn() && (me() == email || twinA() == email || twinB() == email || aliasFor(email)); }
    function onList(col) { return exists(/databases/$(database)/documents/$(col)/$(me())) || exists(/databases/$(database)/documents/$(col)/$(twinA())) || exists(/databases/$(database)/documents/$(col)/$(twinB())); }
    function isCoach() { return isAdmin() || (signedIn() && onList('coaches')); }
    function isPlayer() { return signedIn() && onList('players'); }
    function isSquad() { return isCoach() || isPlayer(); }

    // ERGS Live scoreboard: anyone can watch, only coaches can score
    match /live/{doc} {
      allow read: if true;
      allow write: if isCoach() && request.resource.data.json is string && request.resource.data.json.size() < 900000;
    }
    // who can sign in
    match /coaches/{email} {
      allow read: if isCoach() || mine(email);
      allow write: if isCoach();
    }
    // someone who signed in but isn't on a list yet leaves a request; coaches see it and add them as a player or coach
    match /requests/{email} {
      function reqOK() { return request.resource.data.keys().hasOnly(['name', 'photo', 'at', 'squad', 'pos', 'sent', 'resend', 'kind', 'follow', 'child']) && (!('follow' in request.resource.data) || (request.resource.data.follow is list && request.resource.data.follow.size() <= 12)) && (!('kind' in request.resource.data) || request.resource.data.kind in ['', 'supporter', 'guardian']) && (!('child' in request.resource.data) || (request.resource.data.child is string && request.resource.data.child.size() < 80)) && (!('squad' in request.resource.data) || (request.resource.data.squad is string && request.resource.data.squad.size() < 20)) && (!('pos' in request.resource.data) || (request.resource.data.pos is string && request.resource.data.pos.size() < 4)) && request.resource.data.name is string && request.resource.data.name.size() < 120; }
      allow read: if isCoach() || mine(email);
      allow delete: if isCoach() || mine(email);   // a supporter can remove themselves
      allow create, update: if isCoach();   // a coach can reset the one-hour wait, mark someone as a supporter, or put someone on the list from Access
      allow create: if mine(email) && reqOK();
      // sending again: once an hour, or straight away after a coach resets it; other updates (photo, last seen) don't touch 'sent'
      allow update: if mine(email) && reqOK() && (!('sent' in resource.data) || request.resource.data.get('sent', 0) == resource.data.sent || resource.data.get('resend', false) == true || request.time.toMillis() - resource.data.sent > 3600000);
    }
    // a player sends their own headshot (once a season, unless a coach opens it again); coaches approve it
    match /headshots/{email} {
      allow read: if isCoach() || mine(email);
      allow update, delete: if isCoach();
      allow create, update: if isPlayer() && mine(email)
        && request.resource.data.status == 'pending' && request.resource.data.photo is string && request.resource.data.photo.size() < 950000
        && request.resource.data.season is string
        && (resource == null || resource.data.status == 'open' || resource.data.season != request.resource.data.season);
      // a player can take their own headshot down (they then can't send another this season unless a coach lets them)
      // a player can mark a coach's decision as seen (only the 'seen' field changes)
      allow update: if isPlayer() && mine(email) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seen']);
      allow create, update: if isPlayer() && mine(email) && request.resource.data.status == 'removed' && request.resource.data.photo == '' && request.resource.data.season is string;
    }
    // a player says whether they can play each match; coaches see it when picking the team
    match /avail/{email} {
      allow read: if isCoach() || mine(email);
      allow write: if isPlayer() && mine(email) && request.resource.data.keys().hasOnly(['m', 'name', 'team', 'rid', 'at']) && request.resource.data.m.size() < 60;
      allow delete: if isCoach();
    }
    match /players/{email} {
      allow read: if isCoach() || mine(email);
      allow write: if isCoach();
    }
    // main app: plays, squads and pictures for coaches and players; everything else coaches only
    match /team/{doc} { allow read: if isSquad(); allow write: if isCoach(); }
    match /plays/{doc} { allow read: if isSquad(); allow write: if isCoach(); }
    match /images/{doc} { allow read: if isSquad(); allow write: if isCoach(); }
    match /totw/{doc} { allow read, write: if isCoach(); }
    match /drills/{doc} { allow read: if isSquad(); allow write: if isCoach(); }
    // small headshots for the score animations on ERGS Live: anyone can see them, only coaches add them
    match /faces/{doc} {
      allow read: if true;
      allow write: if isCoach() && request.resource.data.d is string && request.resource.data.d.size() < 120000;
      allow delete: if isCoach();
    }
    // Play IQ leaderboard: each person's best scores; the squad can see the board, you only write your own, coaches can remove an entry
    match /piq/{email} {
      allow read: if isSquad();
      allow delete: if isCoach();
      allow create, update: if isSquad() && mine(email)
        && request.resource.data.keys().hasOnly(['name', 'team', 'week', 'best', 'wk', 'sd', 'sdWk', 'games', 'updated'])
        && request.resource.data.name is string && request.resource.data.name.size() < 60
        && request.resource.data.best is number && request.resource.data.best <= 20000 && request.resource.data.wk is number && request.resource.data.wk <= 20000
        && request.resource.data.sd is number && request.resource.data.sd <= 1000 && request.resource.data.sdWk is number && request.resource.data.sdWk <= 1000;
    }
    // approval emails to the head coach: anyone signed in reads the settings (so a new request can send one), only coaches change them
    match /notify/{doc} { allow read: if signedIn(); allow write: if isCoach(); }
    // Team news: coaches post to a squad (or everyone); the squad reads them
    match /posts/{id} {
      allow read: if isSquad();
      allow create, update: if isCoach() && request.resource.data.text is string && request.resource.data.text.size() < 4000 && request.resource.data.at is number;
      allow delete: if isCoach();
    }
    // read receipts: one doc per player (p: the player's own reads, g: their parent/guardian's); coaches see them all
    match /reads/{email} {
      allow read: if isCoach() || mine(email);
      allow create, update: if isSquad() && mine(email) && request.resource.data.keys().hasOnly(['p', 'g', 'name', 'at']) && request.resource.data.get('p', {}).size() < 400 && request.resource.data.get('g', {}).size() < 400;
      allow delete: if isCoach();
    }
    match /sponsors/{doc} { allow read, write: if isCoach(); }
    match /sheets/{doc} { allow read, write: if isCoach(); }
    match /members/{uid} {
      allow read: if isCoach();
      allow write: if isSquad() && request.auth.uid == uid;
      allow delete: if isCoach();   // Access › Everyone signed in: delete someone's sign-in history
    }
  }
}
